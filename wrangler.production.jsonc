{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omnilux-relay",
  "main": "src/cloudflare/index.ts",
  "compatibility_date": "2026-06-28",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "relay.omnilux.tv/*",
      "zone_name": "omnilux.tv"
    }
  ],
  "vars": {
    "RELAY_CONTROL_URL": "https://api.omnilux.tv/functions/v1",
    "RELAY_GRANT_AUDIENCE": "relay.omnilux.tv",
    "RELAY_LEGACY_COORDINATOR_NAME": "global",
    "RELAY_RENDEZVOUS_NAME": "relay-rendezvous-v1",
    "RELAY_RENDEZVOUS_PARTITIONS": "64",
    "RELAY_HTTP_SESSION_COOKIE": "omnilux_relay_session",
    "RELAY_REGION": "cloudflare-global"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_COORDINATOR",
        "class_name": "RelayCoordinator"
      },
      {
        "name": "RELAY_RENDEZVOUS",
        "class_name": "RelayRendezvous"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayCoordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RelayRendezvous"]
    }
  ]
}
