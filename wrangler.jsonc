{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omnilux-relay-local",
  "main": "src/cloudflare/index.ts",
  "compatibility_date": "2026-06-28",
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "routes": [],
  "vars": {
    "RELAY_CONTROL_URL": "https://api-test.omnilux.tv/functions/v1",
    "RELAY_GRANT_AUDIENCE": "relay-test.omnilux.tv",
    "RELAY_LEGACY_COORDINATOR_NAME": "staging-global",
    "RELAY_RENDEZVOUS_NAME": "relay-rendezvous-v1",
    "RELAY_RENDEZVOUS_PARTITIONS": "64",
    "RELAY_HTTP_SESSION_COOKIE": "omnilux_relay_staging_session",
    "RELAY_REGION": "cloudflare-local-validation"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_COORDINATOR",
        "class_name": "RelayCoordinator"
      },
      {
        "name": "RELAY_RENDEZVOUS",
        "class_name": "RelayRendezvous"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayCoordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RelayRendezvous"]
    }
  ]
}
