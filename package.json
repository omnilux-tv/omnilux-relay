{
  "name": "omnilux-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "build": "tsc -p tsconfig.json",
    "build:worker": "wrangler deploy --config wrangler.jsonc --dry-run",
    "build:worker:staging": "wrangler deploy --config wrangler.staging.jsonc --dry-run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "lint:worker": "tsc -p tsconfig.cloudflare.json --noEmit",
    "start": "node dist/index.js",
    "test:release-config": "node --test --import tsx tests/cloudflare-release-config.test.ts tests/worker-deployment-evidence.test.ts",
    "test:smoke": "node --test --test-concurrency=1 --import tsx tests/*.test.ts",
    "test:worker-smoke": "node --test --test-concurrency=1 --import tsx tests/relay-worker-runtime.smoke.test.ts tests/relay-worker-streaming.test.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@omnilux/api-contracts": "workspace:*",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260628.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "wrangler": "^4.105.0"
  }
}
